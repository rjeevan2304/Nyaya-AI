# ─────────────────────────────────────────────────────────────────────
# Nyaya.ai — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────

# Your Anthropic API key (get one from https://console.anthropic.com)
# This enables AI-powered case analysis summaries
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Qdrant vector database URL (leave as-is if running via Docker locally)
QDRANT_URL=http://localhost:6333
